{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: {
    enabled: true,
  },
  'pre-commit': {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    platformAutomerge: true,
  },
  separateMultipleMajor: true,
  minimumReleaseAge: '7d',
  configMigration: true,
  extends: [
    'config:recommended',
    'schedule:weekly',
    ':semanticCommitTypeAll(chore)',
    ':label(renovate)',
    'helpers:pinGitHubActionDigests',
  ],
  enabledManagers: [
    'cargo',
    'github-actions',
    'npm',
    'pep621',
    'pre-commit',
    'typst',
  ],
  packageRules: [
    {
      description: 'Automerge patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'CI and devDependencies',
      matchManagers: [
        'github-actions',
        'pre-commit',
      ],
    },
    {
      description: 'Automerge CI and devDependencies non-major updates',
      matchManagers: [
        'github-actions',
        'pre-commit',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'pyo3 ecosystem',
      matchManagers: [
        'cargo',
      ],
      matchPackageNames: [
        'pyo3',
        'pyo3-log',
        'pythonize',
      ],
    },
    {
      groupName: 'serde ecosystem',
      matchManagers: [
        'cargo',
      ],
      matchPackageNames: [
        'serde',
        'serde_json',
      ],
    },
    {
      groupName: 'cargo',
      matchJsonata: [
        'isBreaking != true',
      ],
      matchManagers: [
        'cargo',
      ],
    },
    {
      matchDepNames: [
        'python',
      ],
      enabled: false,
    },
    {
      groupName: 'python',
      matchManagers: [
        'pep621',
      ],
    },
    {
      groupName: 'wasm',
      matchJsonata: [
        'isBreaking != true',
      ],
      matchManagers: [
        'npm',
      ],
    },
    {
      groupName: 'typst',
      matchManagers: [
        'typst',
      ],
    },
  ],
}
